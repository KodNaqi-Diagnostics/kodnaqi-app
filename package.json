{
  "name": "kodnaqi-pwa",
  "version": "1.0.0",
  "description": "تطبيق إدارة معمل طبي تشخيصي — PWA يعمل بدون إنترنت",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node obfuscate.js",
    "start": "electron .",
    "build-win": "npm run build && electron-builder --win --x64 --publish never",
    "build-win32": "npm run build && electron-builder --win --ia32"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com"
  },
  "homepage": "https://github.com",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capgo/capacitor-printer": "^8.1.8",
    "@devlas/capacitor-thermal-printer": "^0.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@thumbmarkjs/thumbmarkjs": "^1.12.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.1.0",
    "node-machine-id": "^1.1.12",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^5.10.0"
  },
  "build": {
    "appId": "com.kodnaqi.diagnostics",
    "productName": "KodNaqi Diagnostics",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "trial-manager.js",
      "www_dist/**/*",
      "package.json",
      "!android/",
      "!*.md",
      "!.github/",
      "!www/*.bak"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icons/win/icon.ico",
      "uninstallerIcon": "build/icons/win/icon.ico",
      "installerHeaderIcon": "www_dist/logo.png"
    },
    "asarUnpack": [
      "main.js",
      "preload.js",
      "trial-manager.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KodNaqi-Diagnostics",
        "repo": "kodnaqi-app"
      }
    ]
  }
}

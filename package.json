{
  "name": "kodnaqi-pwa",
  "version": "1.0.0",
  "description": "تطبيق إدارة معمل طبي تشخيصي — PWA يعمل [...]",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node -e \"const fs=require('fs');if(fs.existsSync('www'))fs.rmSync('www',{recursive:true});fs.mkdirSync('www');['.html','.js','.css','.png','.json','.txt'].forEach(e=>fs.readdirSync('.').filter(f=>f.endsWith(e)).forEach(f=>fs.copyFileSync(f,'www/'+f)));if(fs.existsSync('lib'))fs.cpSync('lib','www/lib',{recursive:true});if(fs.existsSync('www/package.json')){const p=JSON.parse(fs.readFileSync('www/package.json'));delete p.build;fs.writeFileSync('www/package.json',JSON.stringify(p,null,2));}console.log('Synced root to www')\"",
    "start": "electron .",
    "build-win": "electron-builder --win --x64 --publish never",
    "build-win32": "electron-builder --win --ia32"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alsunni707/kodnaqi-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Alsunni707/kodnaqi-app/issues"
  },
  "homepage": "https://github.com/Alsunni707/kodnaqi-app#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-printer": "^8.1.8",
    "@devlas/capacitor-thermal-printer": "^0.8.1",
    "@thumbmarkjs/thumbmarkjs": "^1.12.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^44.7.2",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.kodnaqi.diagnostics",
    "productName": "KodNaqi Diagnostics",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "www/**/*",
      "package.json",
      "!android/",
      "!*.md",
      "!.github/",
      "!www/security.js",
      "!www/*.bak"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icons/win/icon.ico",
      "uninstallerIcon": "build/icons/win/icon.ico",
      "installerHeaderIcon": "www/logo.png"
    },
    "asarUnpack": [
      "main.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Alsunni707",
        "repo": "kodnaqi-app"
      }
    ]
  }
}
